<?xml version="1.0" encoding="UTF-8"?>
<xml>
	<pragma once="true" />

	<set name="DISCORD_RPC_MOBILE" value="1" if="android || iphoneos || iphonesim || iphone" />

	<set name="DISCORD_RPC_SOCIAL" value="1" if="android DISCORD_SOCIAL_SDK" />

	<files id="haxe">
		<compilerflag value="-I${haxelib:hxdiscord_rpc}/project/discord-rpc/include" />

		<compilerflag value="-DDISCORD_DISABLE_IO_THREAD" if="DISCORD_DISABLE_IO_THREAD" />
	</files>

	<files id="__main__">
		<compilerflag value="-I${haxelib:hxdiscord_rpc}/project/discord-rpc/include" />

		<compilerflag value="-DDISCORD_DISABLE_IO_THREAD" if="DISCORD_DISABLE_IO_THREAD" />
	</files>

	<files id="discord-social" cxx_standard="17" if="DISCORD_RPC_SOCIAL">
		<compilerflag value="-I${haxelib:hxdiscord_rpc}/project/discord-rpc/include" />
		<compilerflag value="-I${DISCORD_SOCIAL_SDK}/include" />

		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/social_bridge.cpp" />
		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_rpc_social.cpp" />
		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_rpc_queue.cpp" />
	</files>

	<files id="discord-rpc" unless="DISCORD_RPC_SOCIAL">
		<compilerflag value="-I${haxelib:hxdiscord_rpc}/project/discord-rpc/include" />

		<section>

		<compilerflag value="-DRAPIDJSON_SSE2" if="MSVC_VER" unless="HXCPP_M64" />

		<compilerflag value="-I${haxelib:hxdiscord_rpc}/project/rapidjson/include" />

		<compilerflag value="-DDISCORD_DISABLE_IO_THREAD" if="DISCORD_DISABLE_IO_THREAD" />

		<section if="DISCORD_RPC_MOBILE">
			<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/connection_mobile.cpp" />
			<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_register_mobile.cpp" />
		</section>

		<section unless="DISCORD_RPC_MOBILE">
			<section if="windows">
				<compilerflag value="-DWIN32_LEAN_AND_MEAN" />
				<compilerflag value="-DNOMCX" />
				<compilerflag value="-DNOSERVICE" />
				<compilerflag value="-DNOIME" />

				<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/connection_windows.cpp" />
				<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_register_windows.cpp" />
			</section>

			<section if="macos || linux">
				<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/connection_unix.cpp" />

				<section if="macos">
					<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_register_macos.mm" />
				</section>

				<section if="linux">
					<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_register_linux.cpp" />
				</section>
			</section>
		</section>

		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_rpc.cpp" />
		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/rpc_connection.cpp" />
		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/serialization.cpp" />
		<file name="${haxelib:hxdiscord_rpc}/project/discord-rpc/src/discord_rpc_queue.cpp" />
		</section>
	</files>

	<target id="haxe">
		<section if="DISCORD_RPC_SOCIAL">
			<flag value="-L${DISCORD_SOCIAL_SDK}/jni/arm64-v8a" if="HXCPP_ARM64" />
			<flag value="-L${DISCORD_SOCIAL_SDK}/jni/armeabi-v7a" if="HXCPP_ARMV7" />
			<flag value="-L${DISCORD_SOCIAL_SDK}/jni/x86_64" if="HXCPP_X86_64" />
			<flag value="-L${DISCORD_SOCIAL_SDK}/jni/x86" if="HXCPP_X86" />

			<lib name="-ldiscord_partner_sdk" />
		</section>

		<section unless="DISCORD_RPC_MOBILE">
			<section if="mingw">
				<lib name="-lpsapi" />
				<lib name="-ladvapi32" />
			</section>

			<section if="windows" unless="mingw">
				<lib name="psapi.lib" />
				<lib name="advapi32.lib" />
			</section>

			<section if="mingw || macos || linux">
				<lib name="-lpthread" />
			</section>
		</section>

		<files id="discord-social" if="DISCORD_RPC_SOCIAL" />
		<files id="discord-rpc" unless="DISCORD_RPC_SOCIAL" />
	</target>
</xml>
